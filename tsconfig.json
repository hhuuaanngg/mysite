{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": { "@/*": ["./src/*"] },
    "allowJs": true
  },
  "include": [".astro/types.d.ts", "src/**/*", "tests/**/*", "playwright.config.ts"],
  "exclude": ["node_modules", ".studio", ".next", "out"]
}
