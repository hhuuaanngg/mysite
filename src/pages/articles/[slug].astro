---
import { getCollection, render, type CollectionEntry } from "astro:content";
import SiteLayout from "@/layouts/SiteLayout.astro";
import ArticlePage from "@/components/ArticlePage.astro";
import { getArticles, toArticle } from "@/lib/articles";
import { toTableOfContents } from "@/lib/markdown-toc";

export async function getStaticPaths() {
  return (await getCollection("articles")).map((entry) => ({
    params: { slug: entry.id }, props: { entry },
  }));
}
interface Props { entry: CollectionEntry<"articles"> }
const { entry } = Astro.props;
const article = toArticle(entry);
const { Content, headings } = await render(entry);
---
<SiteLayout title={article.title} description={article.summary} image={article.cover} type="article">
  <ArticlePage article={article} articles={await getArticles()} content={entry.body ?? ""} toc={toTableOfContents(headings)}>
    <Content />
  </ArticlePage>
</SiteLayout>
