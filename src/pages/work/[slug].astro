---
import { getCollection, render, type CollectionEntry } from "astro:content";
import SiteLayout from "@/layouts/SiteLayout.astro";
import WorkPage from "@/components/WorkPage.astro";
import { toProject } from "@/lib/projects";
import { toTableOfContents } from "@/lib/markdown-toc";

export async function getStaticPaths() {
  return (await getCollection("works")).map((entry) => ({
    params: { slug: entry.id }, props: { entry },
  }));
}
interface Props { entry: CollectionEntry<"works"> }
const { entry } = Astro.props;
const project = toProject(entry);
const { Content, headings } = await render(entry);
---
<SiteLayout title={project.title} description={project.summary} image={project.cover.image}>
  <WorkPage project={project} content={entry.body ?? ""} toc={toTableOfContents(headings)}>
    <Content />
  </WorkPage>
</SiteLayout>
